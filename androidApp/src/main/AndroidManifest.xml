<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Appels HTTPS : Open-Meteo (Météo), DummyJSON et ses images (Catalogue) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ : demandée par l'écran Réglages quand on active les notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Météo à ma position : position approximative seulement, demandée par l'écran Météo -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".MvpApplication"
        android:allowBackup="false"
        android:label="MVP Modular"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTask : un lien ouvert depuis une autre app revient à l'activité existante (onNewIntent)
             au lieu d'en empiler une seconde dans la tâche de l'app appelante. taskAffinity vide : une autre app
             ne peut pas attirer l'activité dans sa propre tâche en déclarant la même affinité (StrandHogg). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Liens profonds mvpmodular://… (format dans core:deeplink, DeepLinks ; ADR 0008).
                 Pas d'App Links vérifiés tant que l'app n'a pas de domaine. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mvpmodular" />
            </intent-filter>
        </activity>
    </application>
</manifest>
