<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Appels HTTPS : Open-Meteo (Météo), DummyJSON et ses images (Catalogue) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Mode hors ligne : savoir si l'appareil a accès à internet (core:connectivity, ADR 0012) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+ : demandée par l'écran Réglages quand on active les notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Météo à ma position : position approximative seulement, demandée par l'écran Météo -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Rappels par lieu (ADR 0023), demandées par la fiche d'une tâche au moment de poser un rappel : position exacte
         (zones de 100 à 500 m), puis « Toujours autoriser » (Android 10+) pour que le système surveille la zone app fermée.
         La position reste sur l'appareil. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Rappels par lieu : reposer les alertes de proximité après un redémarrage (WorkManager la déclare aussi) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Déverrouillage biométrique (Réglages > Sécurité) : BiometricManager.canAuthenticate l'exige, sinon SecurityException -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".MvpApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="MVP Modular"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- singleTask : un lien ouvert depuis une autre app revient à l'activité existante (onNewIntent)
             au lieu d'en empiler une seconde dans la tâche de l'app appelante. taskAffinity vide : une autre app
             ne peut pas attirer l'activité dans sa propre tâche en déclarant la même affinité (StrandHogg). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Liens profonds mvpmodular://… (format dans core:deeplink, DeepLinks ; ADR 0008).
                 Pas d'App Links vérifiés tant que l'app n'a pas de domaine. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mvpmodular" />
            </intent-filter>
            <!-- Raccourci « Nouvelle tâche » et App Action CREATE_THING de Google Assistant (ADR 0018) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Widget Tâches de l'écran d'accueil (Jetpack Glance, ADR 0011). Exporté : c'est le lanceur qui
             l'installe et le système qui lui envoie APPWIDGET_UPDATE (diffusion protégée). Ce receiver ne fait
             qu'ouvrir MainActivity par un intent explicite. La case à cocher (ADR 0026) passe par le récepteur
             propre à Glance, non exporté, et le use case revérifie session et verrou. -->
        <receiver
            android:name=".widget.TodoWidgetReceiver"
            android:exported="true"
            android:label="Tâches">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/todo_widget_info" />
        </receiver>

        <!-- Widget Météo (ADR 0026). Exporté comme tout widget (exigé par le lanceur) ; il n'ouvre que l'app. -->
        <receiver
            android:name=".widget.WeatherWidgetReceiver"
            android:exported="true"
            android:label="Météo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>

        <!-- Rappels par lieu (ADR 0023) : alertes de proximité du système (core:notifications). Non exporté : seul le
             système, qui détient le PendingIntent explicite, peut l'appeler. -->
        <receiver
            android:name="com.mvp.core.notifications.LocationNotificationReceiver"
            android:exported="false" />

        <!-- Boutons de la notification du mode focus (ADR 0028). Non exporté : appelé seulement par les PendingIntent
             explicites de la notification de l'app. -->
        <receiver
            android:name=".focus.FocusActionReceiver"
            android:exported="false" />

        <!-- Reposer les alertes de proximité, effacées par un redémarrage ou une mise à jour de l'app. Diffusions
             système protégées : le récepteur n'a pas besoin d'être exporté. -->
        <receiver
            android:name=".reminder.LocationRemindersRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
