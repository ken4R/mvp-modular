-- Version 2 -> 3 : synchronisation des tâches (ADR 0012).
ALTER TABLE TodoEntity ADD COLUMN updated_at INTEGER NOT NULL DEFAULT 0;

CREATE TABLE TodoPendingChange (
    todo_id TEXT NOT NULL PRIMARY KEY,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    changed_at INTEGER NOT NULL
);

-- Les tâches créées avant la synchronisation partent au premier envoi (heure 0 : la plus ancienne possible).
INSERT INTO TodoPendingChange(todo_id, is_deleted, changed_at) SELECT id, 0, 0 FROM TodoEntity;
