-- Version 3 -> 4 : notes et pièces jointes des tâches (ADR 0014).
ALTER TABLE TodoEntity ADD COLUMN note TEXT NOT NULL DEFAULT '';

CREATE TABLE TodoAttachmentEntity (
    id TEXT NOT NULL PRIMARY KEY,
    todo_id TEXT NOT NULL,
    file_name TEXT NOT NULL,
    mime_type TEXT NOT NULL,
    size_bytes INTEGER NOT NULL,
    added_at INTEGER NOT NULL
);

CREATE INDEX TodoAttachmentEntity_todo_id ON TodoAttachmentEntity(todo_id);
